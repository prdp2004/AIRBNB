<% layout("/layouts/boilerplate") %>

<!-- <h3 class="mb-4">All Listings</h3> -->
<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }
    .filter{
        margin-top: 2rem;
        margin-bottom: 1rem;
        margin-right: 2rem;
        text-align: center;
        opacity: 0.6;
        min-width: 4.5rem;
        line-height: 1.35;
    }
    .filter:hover{
        opacity: 1;
        cursor: pointer;
    }
    .tax-info{
        display: none;
    }
.tax-toggle{
border: 1px solid black;
border-radius: 1rem;
min-height: 3.2rem;
padding: 0.65rem 1rem;
margin: 1rem 0 0.5rem 0.5rem;
display : flex;
align-items: center;
justify-content: center;
white-space: nowrap;
}
.tax-toggle .form-check {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    min-height: auto;
}
.tax-toggle .form-check-input {
    float: none;
    margin: 0;
    flex: 0 0 auto;
}
.tax-toggle .form-check-label {
    line-height: 1.2;
}
</style>

<div id="filters">
    <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        Trending</div>
<div class="filter">
     <div><i class="fa-solid fa-bed"></i></div>
     Rooms</div>
    <div class="filter">
       <div> <i class="fa-solid fa-mountain-city"></i></div>
        Iconic cities</div>
<div class="filter"> 
    <div><i class="fa-solid fa-mountain"></i></div>
    Mountains</div>

<div class="filter">
       <div><i class="fa-brands fa-fort-awesome"></i></div>
        Castles</div>
<div class="filter"> 
    <div> <i class="fa-solid fa-person-swimming"></i></div>
    Amazing pools</div>
<div class="filter"> 
    <div><i class="fa-solid fa-tent"></i> </div>
  Camping</div>

<div class="filter">
       <div> <i class="fa-solid fa-tractor"></i></div>
        Farms</div>
<div class="filter"> 
    <div> <i class="fa-solid fa-snowplow"></i></div>
   Arctic snow</div>

<div class="filter">
       <div> <i class="fa-solid fa-igloo"></i></div>
        Doms</div>
<div class="filter"> 
    <div><i class="fa-solid fa-sailboat"></i> </div>
  Boats</div>

   <div class="tax-toggle">
<div class="form-check reverse form-switch">
  <input class="form-check-input" 
  type="checkbox" role="switch" 
  id="switchCheckDefault">
  <label class="form-check-label"
   for="switchCheckDefault">Display total after taxes</label>
</div>
 </div>

</div>


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
    <% for (let listing of allListings) { %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card h-100">
                    <img 
                        src="<%= (listing.image && listing.image.url) ? listing.image.url : (typeof listing.image === 'string' && listing.image ? listing.image : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60') %>" 
                        class="card-img-top" 
                        alt="listing_image" 
                        style="height: 20rem; object-fit: cover;"
                    />
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b><br>
    &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
    <i class="tax-info"> +18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>

<script> 
    const taxSwitch = document.getElementById("switchCheckDefault");
    const taxInfo = document.querySelectorAll(".tax-info");

    taxSwitch.addEventListener("change", () => {
        taxInfo.forEach((info) => {
            info.style.display = taxSwitch.checked ? "inline" : "none";
        });
    });
</script>
